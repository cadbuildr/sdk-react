    "react-dom": ">=18.2.0",
    "three": ">=0.160.0"
  },
  "dependencies": {
    "@cadbuildr/cad-kernel-r3f": "^0.2.0"
  },
  "devDependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.169.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.169.0",
    "typescript": "^5.7.2"
  }

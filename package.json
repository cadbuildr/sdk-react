{
  "name": "@cadbuildr/sdk-react",
  "version": "0.4.0",
  "description": "React SDK for embedding CADbuildr-authored configurators on partner storefronts.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
